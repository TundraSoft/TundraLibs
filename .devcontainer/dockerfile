# Use the latest Debian bookworm base image
FROM --platform=linux/amd64 mcr.microsoft.com/devcontainers/base:1-bookworm

# Install Deno
ENV DENO_INSTALL=/usr/local
RUN curl -fsSL https://deno.land/install.sh | sh -s v2.1.2 \
  && mv $HOME/.deno/bin/deno /usr/local/bin/ \
  && chmod +x /usr/local/bin/deno

# Set Deno environment variables
ENV DENO_DIR=/tmp/deno_cache \
  DENO_INSTALL_ROOT=/usr/local/bin

# Install additional tools that might be useful for development
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
  && apt-get -y install --no-install-recommends \
    git \
    curl \
    ca-certificates \
    unzip \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# [Optional] Uncomment this section to install additional OS packages.
# RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
#    && apt-get -y install --no-install-recommends <your-package-list-here>