{
  "deno.enable": true,
  "deno.unstable": ["ffi"],
  "deno.lint": true,
  "deno.cacheOnSave": true,
  "deno.suggest.imports.autoDiscover": true,
  "deno.codeLens.implementations": true,
  "deno.codeLens.references": true,
  "deno.codeLens.referencesAllFunctions": true,
  "deno.codeLens.test": true,
  "deno.codeLens.testArgs": [
    "--allow-read",
    "--allow-write",
    "--allow-env",
    "--allow-net",
    "--allow-ffi",
    "--allow-sys",
    "--unstable-ffi"
  ],

  // Test runner configuration - force Deno for all test files
  "deno.testing.enable": true,
  "deno.testing.args": [
    "--allow-read",
    "--allow-write",
    "--allow-env",
    "--allow-net",
    "--allow-ffi",
    "--allow-sys",
    "--unstable-ffi"
  ],

  // File associations to ensure .test.ts files use Deno
  "files.associations": {
    "*.test.ts": "typescript"
  },

  // TypeScript settings - keep minimal to let Deno handle IntelliSense
  "typescript.preferences.useAliasesForRenames": false,
  "typescript.suggest.enabled": true,
  
  // Ensure Deno takes precedence over TypeScript
  "typescript.enablePromptUseWorkspaceTsdk": false,
  
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "denoland.vscode-deno",
  "sonarlint.connectedMode.project": {
    "connectionId": "tundrasoft",
    "projectKey": "TundraSoft_TundraLibs"
  },
  "sonarlint.disableTelemetry": true,
  "sonarlint.pathToNodeExecutable": "",
  "sonarlint.output.showAnalyzerLogs": false,
  "sonarlint.output.showVerboseLogs": false,
  "files.exclude": {
    "**/.sonarlint": true
  },
  "sonarlint.rules": {
    "typescript:S6582": {
      "level": "off"
    },
    "typescript:S1186": {
      "level": "off"
    },
    "typescript:S3776": {
      "level": "off"
    },
    "typescript:S2814": {
      "level": "off"
    },
    "typescript:S6551": {
      "level": "off"
    },
    "typescript:S2245": {
      "level": "off"
    },
    "typescript:S6478": {
      "level": "off"
    }
  },
  "sonarlint.pathToCompileCommands": "",
  "sonarlint.testFilePattern": "**/*.test.ts,**/*.bench.ts,**/tests/**/*.ts",
  "sonarlint.analysisExcludesStandalone": "**/.vscode-test/**, **/.vscode/**, **/*.test.ts, **/tests/**, **/tests/**.test.ts, .github/**"
}