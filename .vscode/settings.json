{
  "deno.enable": true,
  "deno.unstable": [],
  "deno.lint": true,
  "deno.cacheOnSave": true,
  "deno.suggest.imports.autoDiscover": true,
  "deno.codeLens.implementations": true,
  "deno.codeLens.references": true,
  "deno.codeLens.referencesAllFunctions": true,
  "deno.codeLens.test": true,
  "deno.codeLens.testArgs": [
    "--allow-read",
    "--allow-write",
    "--allow-env",
    "--allow-net",
    "--allow-ffi",
    "--allow-sys",
    "--unstable-ffi"
  ],

  // Test runner configuration - force Deno for all test files
  "deno.testing.enable": true,
  "deno.testing.args": [
    "--allow-read",
    "--allow-write", 
    "--allow-env",
    "--allow-net",
    "--allow-ffi",
    "--allow-sys",
    "--unstable-ffi"
  ],

  // File associations to ensure .test.ts files use Deno
  "files.associations": {
    "*.test.ts": "typescript"
  },

  // TypeScript settings - keep minimal to let Deno handle IntelliSense
  "typescript.preferences.useAliasesForRenames": false,
  "typescript.suggest.enabled": true, // Commented out - this was preventing IntelliSense
  
  // Ensure Deno takes precedence over TypeScript
  "typescript.enablePromptUseWorkspaceTsdk": false,
  
  "editor.tabSize": 2,
  "editor.formatOnSave": false,
  "editor.defaultFormatter": "denoland.vscode-deno",
  "sonarlint.connectedMode.project": {
    "connectionId": "Sonar",
    "projectKey": "TundraSoft_TundraLibs"
  },
  // "github.copilot.enable": {
  //   "*": true,
  //   "plaintext": false,
  //   "markdown": false,
  //   "scminput": false
  // },
  // "sonarlint.testFilePattern": "**/*.test.ts",
  "sonarlint.analysisExcludesStandalone": "**/.vscode-test/**, **/.vscode/**, **/*.test.ts, **/tests/**, **/tests/**.test.ts, .github/**",
}