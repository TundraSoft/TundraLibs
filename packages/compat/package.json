{
  "name": "@tundralibs/compat",
  "version": "2.7.1",
  "type": "module",
  "description": "Compatibility layer smoothing API differences across Deno, Bun, and Node.js",
  "keywords": [
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cross-runtime",
    "compatibility",
    "polyfill",
    "runtime",
    "fetch",
    "filesystem",
    "webserver",
    "websocket"
  ],
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./bench": "./bench.ts",
    "./cli": "./cli/mod.ts",
    "./common": "./common.ts",
    "./fetch": "./fetch.ts",
    "./file": "./file.ts",
    "./http": "./http.ts",
    "./net": "./net.ts",
    "./udp": "./udp.ts",
    "./path": "./path.ts",
    "./permissions": "./permissions.ts",
    "./runtime": "./runtime.ts",
    "./test": "./test.ts",
    "./watch": "./watch.ts",
    "./webserver": "./webserver/mod.ts",
    "./websocket": "./websocket/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@std/media-types": "npm:@jsr/std__media-types@^1.1.0",
    "@std/path": "npm:@jsr/std__path@^1.1.6",
    "@std/testing": "npm:@jsr/std__testing@^1.0.20",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/bun": "latest",
    "@types/deno": "latest",
    "@types/ws": "^8.5.0"
  }
}
