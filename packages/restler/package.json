{
  "name": "@tundralibs/restler",
  "version": "1.1.7",
  "description": "Cross-runtime REST API client base class for building typed per-vendor SDKs on Deno, Bun, and Node.js",
  "keywords": [
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cross-runtime",
    "rest",
    "rest-client",
    "http-client",
    "api-client",
    "sdk",
    "fetch"
  ],
  "license": "MIT",
  "type": "module",
  "main": "mod.ts",
  "exports": {
    ".": "./mod.ts",
    "./types": "./types/mod.ts",
    "./errors": "./errors/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "$xml": "npm:@jsr/libs__xml@^8.0.0",
    "@tundralibs/compat": "workspace:*",
    "@tundralibs/utils": "workspace:*"
  }
}
