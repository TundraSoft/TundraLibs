# Optional test-isolation knobs — CI sets these; local runs may omit them:
#   DB_SCHEMA        when set, live suites target `${DB_SCHEMA}_<pkg>` databases
#                    (e.g. ci_drivers) so parallel suites never collide.
#   MONGO_AUTHSOURCE auth database for the Mongo user (a root user lives in `admin`).
#   MEMCACHED_PORT2  dedicated memcached for this suite's global flush() tests,
#                    keeping them off cacher's shared instance.
DB_SCHEMA=
MONGO_AUTHSOURCE=

MARIA_HOST=
MARIA_PORT=
MARIA_USERNAME=
MARIA_PASSWORD=

MEMCACHED_HOST=
MEMCACHED_PORT=
MEMCACHED_PORT2=
MEMCACHED_SIZE=100

MONGO_HOST=
MONGO_PORT=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DB=

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DB=

REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=

