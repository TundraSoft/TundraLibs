{
  "name": "@tundralibs/utils",
  "version": "1.3.1",
  "type": "module",
  "description": "Core TypeScript building blocks \u2014 the typed Options + Events base class, BaseError, Singleton, and shared helpers (config/env, memoize, IP/subnet, free-port)",
  "keywords": [
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cross-runtime",
    "utilities",
    "options",
    "events",
    "error-handling",
    "memoize",
    "throttle",
    "singleton",
    "config"
  ],
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./types": "./types/mod.ts",
    "./BaseError": "./BaseError.ts",
    "./Config": "./Config.ts",
    "./Events": "./Events.ts",
    "./Options": "./Options.ts",
    "./envArgs": "./envArgs.ts",
    "./getFreePort": "./getFreePort.ts",
    "./ipUtils": "./ipUtils.ts",
    "./isInSubnet": "./isInSubnet.ts",
    "./isPublicIP": "./isPublicIP.ts",
    "./isSubnet": "./isSubnet.ts",
    "./memoize": "./memoize.ts",
    "./once": "./once.ts",
    "./privateObject": "./privateObject.ts",
    "./syslog": "./syslog.ts",
    "./templatize": "./templatize.ts",
    "./throttle": "./throttle.ts",
    "./variableReplacer": "./variableReplacer.ts",
    "./Singleton": "./singleton.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@std/toml": "npm:@jsr/std__toml@^1.0.11",
    "@std/yaml": "npm:@jsr/std__yaml@^1.2.0",
    "@std/jsonc": "npm:@jsr/std__jsonc@^1.0.2",
    "@tundralibs/compat": "workspace:*"
  }
