{
  "name": "@tundralibs/slogger",
  "version": "1.2.2",
  "description": "Cross-runtime structured logging that fans one record out to many formats in-process — console, JSON, syslog, file, HTTP, TCP, or any custom handler",
  "keywords": [
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cross-runtime",
    "logging",
    "logger",
    "structured-logging",
    "syslog",
    "json-logging",
    "log"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./errors": "./errors/mod.ts",
    "./handlers": "./handlers/mod.ts",
    "./formatters": "./formatters/mod.ts",
    "./types": "./types/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@std/fmt": "npm:@jsr/std__fmt@^1.0.10",
    "@std/datetime": "npm:@jsr/std__datetime@^0.225.7",
    "@tundralibs/utils": "workspace:*",
    "@tundralibs/compat": "workspace:*",
    "@tundralibs/id": "workspace:*"
  }
}
