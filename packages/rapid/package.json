{
  "name": "@tundralibs/rapid",
  "version": "1.0.0",
  "description": "rAPId — config-driven application framework: HTTP routes, WebSocket commands and cron jobs behind one middleware onion, decorated modules, an HTML-over-the-wire UI layer, native observability (slogger, tracer, ambient correlation) and pact authentication.",
  "license": "MIT",
  "type": "module",
  "main": "mod.ts",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli/mod.ts",
    "./context": "./context/mod.ts",
    "./decorators": "./decorators/mod.ts",
    "./endpoints": "./endpoints/mod.ts",
    "./errors": "./errors/mod.ts",
    "./middlewares": "./middlewares/mod.ts",
    "./middlewares/pact": "./middlewares/pact.ts",
    "./modules": "./modules/mod.ts",
    "./testing": "./testing/mod.ts",
    "./types": "./types/mod.ts",
    "./ui": "./ui/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@tundralibs/ambient": "workspace:*",
    "@tundralibs/compat": "workspace:*",
    "@tundralibs/cronus": "workspace:*",
    "@tundralibs/crypt": "workspace:*",
    "@tundralibs/doctor": "workspace:*",
    "@tundralibs/id": "workspace:*",
    "@tundralibs/metro-man": "workspace:*",
    "@tundralibs/pact": "workspace:*",
    "@tundralibs/radrouter": "workspace:*",
    "@tundralibs/rpc": "workspace:*",
    "@tundralibs/slogger": "workspace:*",
    "@tundralibs/tracer": "workspace:*",
    "@tundralibs/utils": "workspace:*"
  },
  "devDependencies": {
    "@tundralibs/guardian": "workspace:*",
    "@tundralibs/norm": "workspace:*"
  }
}
