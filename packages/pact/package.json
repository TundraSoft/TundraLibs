    "cross-runtime",
    "auth",
    "authentication",
    "authorization",
    "jwt",
    "oauth2",
    "oidc",
    "rbac",
    "permissions",
    "sessions",
    "api-keys",
    "totp",
    "mfa",
    "hmac",
    "access-control"
  ],
  "license": "MIT",
  "type": "module",
  "main": "mod.ts",
  "exports": {
    ".": "./mod.ts",
    "./errors": "./errors/mod.ts",
    "./types": "./types/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@tundralibs/cacher": "workspace:*",
    "@tundralibs/compat": "workspace:*",
    "@tundralibs/crypt": "workspace:*",
    "@tundralibs/id": "workspace:*",
    "@tundralibs/restler": "workspace:*",
    "@tundralibs/utils": "workspace:*"
  }
}
