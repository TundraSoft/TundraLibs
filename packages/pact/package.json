{
  "name": "@tundralibs/pact",
  "version": "0.6.0",
  "description": "Permissions, Authentication, Control & Tokens — a transport-agnostic authentication & authorization toolkit: RBAC BigInt-bitmask permissions, JWT & opaque sessions with refresh-token rotation, passkeys (WebAuthn/FIDO2), four credential schemes (password, bearer, API keys, HMAC), TOTP MFA, an OAuth2/OIDC client, and drop-in middleware for express/fastify/oak/hono — all over flat bring-your-own-storage hooks",
  "keywords": [
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cross-runtime",
    "auth",
    "authentication",
    "authorization",
    "jwt",
    "oauth2",
    "oidc",
    "rbac",
    "permissions",
    "sessions",
    "api-keys",
    "totp",
    "mfa",
    "hmac",
    "access-control",
    "passkeys",
    "webauthn",
    "passwordless",
    "fido2"
  ],
  "license": "MIT",
  "type": "module",
  "main": "mod.ts",
  "exports": {
    ".": "./mod.ts",
    "./errors": "./errors/mod.ts",
    "./middleware": "./middleware/mod.ts",
    "./middleware/express": "./middleware/express.ts",
    "./middleware/fastify": "./middleware/fastify.ts",
    "./middleware/hono": "./middleware/hono.ts",
    "./middleware/oak": "./middleware/oak.ts",
    "./types": "./types/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bun test"
  },
  "devDependencies": {
    "@oak/oak": "npm:@jsr/oak__oak@^17.0.0"
  },
  "dependencies": {
    "@std/encoding": "npm:@jsr/std__encoding@1.0.11",
    "@tundralibs/cacher": "workspace:*",
    "@tundralibs/compat": "workspace:*",
    "@tundralibs/crypt": "workspace:*",
    "@tundralibs/guardian": "workspace:*",
    "@tundralibs/id": "workspace:*",
    "@tundralibs/restler": "workspace:*",
    "@tundralibs/utils": "workspace:*"
  }
}
