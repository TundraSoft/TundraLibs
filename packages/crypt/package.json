{
  "name": "@tundralibs/crypt",
  "version": "1.3.0",
  "type": "module",
  "description": "Cross-runtime cryptography — hashing, AES/RSA encryption, HMAC/RSA signing, JWT, OTP, key derivation, and secure random",
  "keywords": [
    "typescript",
    "deno",
    "bun",
    "nodejs",
    "cross-runtime",
    "cryptography",
    "crypto",
    "encryption",
    "aes",
    "rsa",
    "hashing",
    "hmac",
    "jwt",
    "otp",
    "totp",
    "key-derivation",
    "signing"
  ],
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cbor": "./cbor/mod.ts",
    "./digest": "./digest/mod.ts",
    "./encrypt": "./encrypt/mod.ts",
    "./generators": "./generators/mod.ts",
    "./JWT": "./JWT/mod.ts",
    "./OTP": "./OTP/mod.ts",
    "./sign": "./sign/mod.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@std/encoding": "npm:@jsr/std__encoding@1.0.11",
    "@std/fmt": "npm:@jsr/std__fmt@^1.0.10",
    "@tundralibs/utils": "workspace:*"
  },
  "devDependencies": {
    "@tundralibs/compat": "workspace:*"
  }
}
